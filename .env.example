DATABASE_URL=yourdbconnectionstring
# or
DATABASE_HOST=YOURDBHOSTURL
DATABASE_PASSWORD=YOURDBPASSWORD
DATABASE_USER=YOURDBUSER
DATABASE_NAME=YOURDBDATABASE
DATABASE_PORT=5432

BGG_ACCESS_TOKEN=very_secret_bgg_token

BGG_STALE_TIME=1d

# Optional: set to true to refresh ALL boardgames rows (can take a long time if you have a large table).
# Default: only refresh boardgames referenced by userBoardgames or sessions.
BGG_SYNC_ALL=false
